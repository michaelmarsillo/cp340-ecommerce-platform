{
  "name": "moss-and-mind",
  "private": true,
  "version": "0.1.0",
  "description": "Moss & Mind - a student-focused e-commerce concept for CP340.",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
