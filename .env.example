# Copy to .env.local for npm run dev. Never commit actual credentials.
# Server-only Stripe sandbox key; live keys are intentionally rejected.
STRIPE_SECRET_KEY=
# Local URL must match the address you open in your browser.
APP_URL=http://127.0.0.1:5173
# In Vercel, set APP_URL=https://mossandmind.vercel.app instead.
# VITE_ variables are public browser data. Never prefix a secret with VITE_.
